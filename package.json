{
  "name": "gogoga-ui-shelf",
  "version": "0.1.0",
  "description": "Collect UI component libraries in Obsidian, tag every component, and preview it live inside your notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "smoke": "node esbuild.config.mjs smoke && node build/smoke.mjs",
    "lint": "eslint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@tailwindcss/browser": "4.1.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "html-to-image": "1.11.13",
    "obsidian": "^1.14.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sucrase": "3.35.0",
    "tailwind-merge": "3.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
